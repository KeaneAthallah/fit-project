# ==== Finance Report Extractor - environment configuration ====
# Copy to .env and fill in values. NEVER commit the real .env.

# Directories
INPUT_DIRECTORY=./XBRL
OUTPUT_DIRECTORY=./output
DATABASE_URL=sqlite:///./database/processing.db

# Processing
WORKERS=10
OCR_WORKERS=4

# OCR
OCR_ENGINE=tesseract
OCR_LANGUAGE=ind+eng
# Full path to tesseract binary on Windows, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=
# Scratch dir for tesseract's per-page PNG/TSV files. Add it to the Defender
# exclusion list (see README) or every page image gets scanned on write.
OCR_TEMP_DIR=./data/tmp/tesseract
# Language-pack dir (must contain every *.traineddata in use). Copy them from
# C:\Program Files\Tesseract-OCR\tessdata, then download missing ones:
#   https://github.com/tesseract-ocr/tessdata/raw/main/ind.traineddata
# Empty = use the tesseract install's own tessdata.
OCR_TESSDATA_DIR=./data/tessdata
# Simultaneous tesseract processes. Each is internally multi-threaded, so this
# is normally lower than WORKERS.
OCR_MAX_CONCURRENT=4

# AI provider: openai | openai-compatible | ollama | none
AI_PROVIDER=none
AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL=http://localhost:11434

# Quality thresholds
CONFIDENCE_THRESHOLD=0.80
HIGH_CONFIDENCE=0.95
VALIDATION_TOLERANCE=0.01
# Dual tolerance for accounting checks (pass if EITHER is satisfied):
VALIDATION_ABSOLUTE_TOLERANCE=1000
VALIDATION_RELATIVE_TOLERANCE=0.001

# Processing mode: fast | balanced | accurate (default balanced)
PROCESSING_MODE=balanced
MAX_AI_CONCURRENT_REQUESTS=2

# Language
LANGUAGE=id+en

# Security notice: when AI_PROVIDER is not "none", document content will be
# sent to an EXTERNAL AI service. Set SEND_TO_EXTERNAL_AI=true to acknowledge.
SEND_TO_EXTERNAL_AI=false